{
  "name": "coding-harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "wizard": "tsx src/cli/index.ts",
    "harness": "tsx src/cli/index.ts",
    "pin": "tsx scripts/pin-from-file.ts",
    "check": "npm run lint && vitest run",
    "eval": "tsx scripts/eval-calibrate.ts",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "smoke:openrouter": "tsx scripts/smoke-openrouter.ts",
    "license:inventory": "tsx scripts/license-inventory.ts",
    "verify:model-artifact": "tsx scripts/verify-model-artifact.ts",
    "docs:components": "node scripts/docs/gen-components.mjs",
    "docs:check": "node scripts/docs/gen-components.mjs --check && node scripts/docs/check-docs.mjs",
    "events:report": "node scripts/events/failure-report.mjs",
    "ci:secrets": "node scripts/ci/secret-scan.mjs",
    "smoke:vercel-sandbox": "tsx scripts/smoke-vercel-sandbox.ts",
    "bench:architecture": "tsx scripts/architecture-baseline.ts && tsx scripts/architecture-reservation-baseline.ts && tsx scripts/architecture-indexing-baseline.ts && tsx scripts/architecture-semantic-reindex-baseline.ts"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.30.0",
    "@napi-rs/keyring": "^2.1.0",
    "@vercel/sandbox": "3.9.1",
    "ajv": "^8.20.0",
    "apache-arrow": "18.1.0",
    "cordis": "4.0.0-rc.10",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/sandbox-mock": "3.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "guarded-fetch": {
      "undici": "7.30.2"
    }
  }
}
